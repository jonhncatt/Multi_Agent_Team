{
  "schema_version": 1,
  "suite": "c_style_cpp_agent_quality",
  "description": "Live Agent baseline for specification-driven C-style code in a .cpp project.",
  "cases": [
    {
      "name": "c_style_cpp_protocol_frame_parser",
      "kind": "agent_workspace",
      "fixture": "evals/fixtures/agent_quality/c_style_cpp_protocol_frame_parser",
      "message": "请直接完成这个项目中的协议帧解析函数。先阅读 SPEC.md、RULES.md、include/frame_parser.h 和 reference/checksum_reference.cpp，理解规格、限制和参考算法。只允许修改 src/frame_parser.cpp；不要修改规格、规则、头文件、参考代码、测试或验证脚本。实现必须保持过程式 C 风格，不使用类、模板、STL、异常或动态内存。完成修改后，使用当前可用的 Python 解释器运行 run_checks.py。请根据真实检查结果收口，不要在检查失败或无法运行时声称已经通过。",
      "settings": {
        "locale": "zh-CN",
        "max_output_tokens": 8192,
        "enable_tools": true,
        "permission_profile": "auto",
        "response_style": "normal"
      },
      "required_context_files": [
        "SPEC.md",
        "RULES.md",
        "include/frame_parser.h",
        "reference/checksum_reference.cpp"
      ],
      "target_files": [
        "src/frame_parser.cpp"
      ],
      "allowed_changed_files": [
        "src/frame_parser.cpp"
      ],
      "protected_files": [
        "SPEC.md",
        "RULES.md",
        "include/frame_parser.h",
        "reference/checksum_reference.cpp",
        "tests/frame_parser_tests.cpp",
        "run_checks.py"
      ],
      "ignored_change_globs": [
        ".eval_build/**",
        "**/__pycache__/**",
        "**/*.pyc"
      ],
      "c_style_rules": {
        "files": [
          "src/frame_parser.cpp"
        ],
        "forbidden_patterns": [
          {"label": "class", "pattern": "\\bclass\\s+[A-Za-z_]"},
          {"label": "template", "pattern": "\\btemplate\\s*<"},
          {"label": "namespace", "pattern": "\\bnamespace\\s+[A-Za-z_]"},
          {"label": "STL namespace", "pattern": "\\bstd\\s*::"},
          {"label": "STL header", "pattern": "#\\s*include\\s*<\\s*(vector|string|array|map|set|memory|algorithm)\\s*>"},
          {"label": "dynamic new", "pattern": "\\bnew\\b"},
          {"label": "dynamic delete", "pattern": "\\bdelete\\b"},
          {"label": "C heap allocation", "pattern": "\\b(malloc|calloc|realloc|free)\\s*\\("},
          {"label": "exception throw", "pattern": "\\bthrow\\b"},
          {"label": "exception try", "pattern": "\\btry\\s*\\{"},
          {"label": "exception catch", "pattern": "\\bcatch\\s*\\("},
          {"label": "virtual dispatch", "pattern": "\\bvirtual\\b"}
        ]
      },
      "verification": {
        "script": "run_checks.py",
        "command_markers": [
          "run_checks.py"
        ],
        "timeout_sec": 90
      }
    }
  ]
}
