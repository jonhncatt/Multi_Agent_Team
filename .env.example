# Validation Assistant env
# Copy to `.env`, then keep only one LLM profile enabled.

# Core app settings
VA_APP_PORT=8080
VA_EXECUTION_MODE=host
# `.env` is loaded only from the Validation Assistant repository root.
# To keep it elsewhere, set absolute `VA_DOTENV_PATH` in the process that starts VA.
# Team Skill credentials belong in the real `.env` as named variables; Skill scripts read them from the inherited process environment.
# VA_DEFAULT_LOCALE=ja-JP  # supported: zh-CN / ja-JP / en; used on first launch when no locale is saved in the browser

# Profile A: OpenAI official + API key
# VA_LLM_PROVIDER=openai
# VA_OPENAI_API_KEY=
# VA_OPENAI_DEFAULT_MODEL=gpt-5.1-chat

# Profile B: OpenAI-compatible gateway
# VA_LLM_PROVIDER=openai_compatible
# VA_OPENAI_COMPAT_API_KEY=
# VA_OPENAI_COMPAT_BASE_URL=
# VA_OPENAI_COMPAT_CA_CERT_PATH=/absolute/path/to/your-root-ca.pem
# VA_OPENAI_COMPAT_DEFAULT_MODEL=gpt-5.1-chat

# Profile C: OpenRouter
# VA_LLM_PROVIDER=openrouter
# VA_OPENROUTER_API_KEY=
# VA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VA_OPENROUTER_DEFAULT_MODEL=google/gemma-4-31b-it:free
# VA_OPENROUTER_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free

# Profile E: Local Ollama
# VA_LLM_PROVIDER=ollama
# VA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# VA_OLLAMA_API_KEY=ollama
# VA_OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Optional limits
# VA_MAX_OUTPUT_TOKENS=16384
# VA_MAX_USER_REQUEST_CHARS=4000000
# VA_MAX_ATTACHMENT_CHARS=1000000
# Main Threads share this global concurrent run cap. The built-in default is 5.
# VA_MAX_CONCURRENT_RUNS=5
# Independent Subagents are read-only and share this per-parent concurrency cap.
# VA_MAX_CONCURRENT_SUBAGENTS=3
# Override only when the provider deployment's usable context is verified.
# VA_CONTEXT_WINDOW_TOKENS=0
# Optional API/model maximum shown in diagnostics; it does not raise the operational window by itself.
# VA_MODEL_MAX_CONTEXT_WINDOW_TOKENS=0
# VA_CONTEXT_AUTO_COMPACT_TOKEN_LIMIT=0
# VA_CONTEXT_AUTO_COMPACT_RATIO=0.9
# VA_CONTEXT_DANGER_COMPACT_RATIO=0.95
# VA_CONTEXT_HISTORY_SOFT_LIMIT_TOKENS=120000
# VA_CONTEXT_EXACT_STALE_SEC=60
# Model-visible cap per tool result. Omitted output is persisted and resumable by result_ref.
# VA_TOOL_OUTPUT_TOKEN_LIMIT=10000
# VA_MAX_UPLOAD_MB=200
# Permission profile: chat (read-only/offline), code (default coding/offline), full_dev (network-enabled but still bounded).
# VA_PERMISSION_PROFILE=code
# Extra roots are explicit only. Downloads/Desktop/workbench are not included by default.
# VA_EXTRA_ALLOWED_ROOTS=
# VA_ALLOW_WORKSPACE_SIBLING_ACCESS=false
# VA_ALLOWED_COMMANDS is a full override. If you customize it, include the full safe list.
# Do not add high-risk commands such as rm, chmod, chown, sudo, dd, kill, pkill, or brew.
# Add network/supply-chain commands such as curl, wget, pip, pip3, or npx only if you want Full Dev to request one-command approval for them.
# VA_ALLOWED_COMMANDS=pwd,ls,dir,where,cat,rg,head,tail,wc,find,echo,printf,date,python,py,python3,git,npm,node,pytest,sed,awk,mkdir,touch,cp,mv
# VA_WEB_ALLOWED_DOMAINS=
# Empty means all domains are allowed in Full Dev. Downloaded and extracted network-origin files are tainted; executing them requires one-command approval.
# VA_WEB_FETCH_MAX_CHARS=120000

# Optional browser settings for internal sites that require an interactive Chrome login.
# Default keeps the previous Playwright-managed Chromium behavior.
# VA_BROWSER_MODE=playwright
# To use the installed Google Chrome with a dedicated visible profile:
# VA_BROWSER_MODE=chrome_profile
# VA_BROWSER_CHANNEL=chrome
# VA_BROWSER_HEADLESS=false
# VA_BROWSER_USER_DATA_DIR=app/data/browser_profile
# VA_BROWSER_EXECUTABLE_PATH=
# VA_BROWSER_PROXY_SERVER=
# VA_BROWSER_IGNORE_HTTPS_ERRORS=false
# VA_BROWSER_CHROMIUM_SANDBOX=true
# VA_BROWSER_DISABLE_PASSWORD_MANAGER=true

# Optional desktop launcher settings. These are read only by desktop/launcher.py and
# the Windows ValidationAssistant.exe; they do not change Agent Runtime behavior.
# Keep this profile separate from VA_BROWSER_USER_DATA_DIR above.
# VA_DESKTOP_SHELL=chrome
# VA_DESKTOP_BROWSER_PATH=
# VA_DESKTOP_BROWSER_USER_DATA_DIR=app/data/desktop_browser_profile
# VA_DESKTOP_STARTUP_TIMEOUT_SEC=45
# VA_DESKTOP_INITIAL_WINDOW_SIZE=1360,840
# VA_DESKTOP_UI_SCALE=0.8
