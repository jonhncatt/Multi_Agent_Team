# Vintage Programmer env
# Copy to `.env`, then keep only one LLM profile enabled.

# Core app settings
VP_APP_PORT=8080
VP_EXECUTION_MODE=host
# VP_DEFAULT_LOCALE=ja-JP  # supported: zh-CN / ja-JP / en; used on first launch when no locale is saved in the browser

# Profile A: OpenAI official + API key
# VP_LLM_PROVIDER=openai
# VP_OPENAI_API_KEY=
# VP_OPENAI_DEFAULT_MODEL=gpt-5.1-chat

# Profile B: OpenAI-compatible gateway
# VP_LLM_PROVIDER=openai_compatible
# VP_OPENAI_COMPAT_API_KEY=
# VP_OPENAI_COMPAT_BASE_URL=
# VP_OPENAI_COMPAT_CA_CERT_PATH=/absolute/path/to/your-root-ca.pem
# VP_OPENAI_COMPAT_DEFAULT_MODEL=gpt-5.1-chat

# Profile C: OpenRouter
# VP_LLM_PROVIDER=openrouter
# VP_OPENROUTER_API_KEY=
# VP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VP_OPENROUTER_DEFAULT_MODEL=google/gemma-4-31b-it:free
# VP_OPENROUTER_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free

# Profile E: Local Ollama
# VP_LLM_PROVIDER=ollama
# VP_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# VP_OLLAMA_API_KEY=ollama
# VP_OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Optional limits
# VP_MAX_OUTPUT_TOKENS=4096
# VP_MAX_UPLOAD_MB=200
# Permission profile: chat (read-only/offline), code (default coding/offline), full_dev (network-enabled but still bounded).
# VP_PERMISSION_PROFILE=code
# Extra roots are explicit only. Downloads/Desktop/workbench are not included by default.
# VP_EXTRA_ALLOWED_ROOTS=
# VP_ALLOW_WORKSPACE_SIBLING_ACCESS=false
# VP_ALLOWED_COMMANDS is a full override. If you customize it, include the full safe list.
# Do not add high-risk commands such as rm, chmod, chown, sudo, dd, kill, pkill, or brew.
# Add network/supply-chain commands such as curl, wget, pip, pip3, or npx only if you want Full Dev to request one-command approval for them.
# VP_ALLOWED_COMMANDS=pwd,ls,dir,cat,rg,head,tail,wc,find,echo,printf,date,python,py,python3,git,npm,node,pytest,sed,awk,mkdir,touch,cp,mv
# VP_WEB_ALLOWED_DOMAINS=
# Empty means all domains are allowed in Full Dev. Downloaded and extracted network-origin files are tainted; executing them requires one-command approval.
# VP_WEB_FETCH_MAX_CHARS=120000

# Optional browser settings for internal sites that require an interactive Chrome login.
# Default keeps the previous Playwright-managed Chromium behavior.
# VP_BROWSER_MODE=playwright
# To use the installed Google Chrome with a dedicated visible profile:
# VP_BROWSER_MODE=chrome_profile
# VP_BROWSER_CHANNEL=chrome
# VP_BROWSER_HEADLESS=false
# VP_BROWSER_USER_DATA_DIR=app/data/browser_profile
# VP_BROWSER_EXECUTABLE_PATH=
# VP_BROWSER_PROXY_SERVER=
# VP_BROWSER_IGNORE_HTTPS_ERRORS=false
